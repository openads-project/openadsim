### Runtime Profiles
COMPOSE_PROFILES=carla,traffic,no-testing,perception,planning
COMPOSE_FILE=docker-compose.yml:examples/cooperative-perception/docker-compose.override.yml

### Vehicle Configuration
VEHICLE=karl
SENSORS=global-sensors.json,karl-basic.json,rita-minimal.json

### Map Configuration
MAP=campus
CUSTOM_OPENDRIVE=
CUSTOM_LANELET=
SPAWN_POINT=50.779551,6.050371,256.0,-8.0,wgs84
ORIGIN_LAT=
ORIGIN_LON=
LANELET_RELOAD=true

### Scenario Configuration
SCENARIO_FILE=

### Additional Options
USE_SIM_TIME=true
ROS_TRACING=false
