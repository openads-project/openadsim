openadservice:
  namePrefix: {{ env "DEPLOYMENT_PREFIX" | quote }}
{{- if env "NODE" }}
  nodeSelector:
    kubernetes.io/hostname: {{ env "NODE" | quote }}
{{- end }}
  name: robot-state-publisher
  image: ghcr.io/openads-project/monitoring:v1.0.0
  args:
  - {{ "/bin/bash" | quote }}
  - {{ "-ic" | quote }}
  - |-
{{ (printf "%s%s%s%s%s%s" "ros2 run robot_state_publisher robot_state_publisher \\\n  /urdf/" (default "karl" (env "VEHICLE")) "/" (default "karl" (env "VEHICLE")) ".urdf \\\n  --ros-args -p use_sim_time:=" (default "true" (env "USE_SIM_TIME"))) | indent 4 }}
  env:
    ROS_DOMAIN_ID: {{ (default "0" (env "ROS_DOMAIN_ID")) | quote }}
    RMW_IMPLEMENTATION: rmw_zenoh_cpp
    RUST_LOG: zenoh=warn
    ZENOH_ROUTER_CHECK_ATTEMPTS: 0
  volumes:
  - mountPath: /urdf
    hostPath: {{ (printf "%s/%s" (requiredEnv "OPENADSIM_PATH") ".runtime/openads-assets-v1.0.0" | clean) | quote }}
  dependsOn:
  - host: zenoh-router
    port: 7447
