openadservice:
  namePrefix: {{ env "DEPLOYMENT_PREFIX" | quote }}
{{- if env "NODE" }}
  nodeSelector:
    kubernetes.io/hostname: {{ env "NODE" | quote }}
{{- end }}
  args:
  - /bin/bash
  - -ic
  - |-
    ros2 launch point_cloud_fusion point_cloud_fusion.launch.py \
      namespace:=${NAMESPACE} \
      name:=${NAME} \
      log_level:=${LOG_LEVEL} \
      use_sim_time:=${USE_SIM_TIME} \
      params:=${PARAMS} \
      trace:=${TRACE} \
      point_cloud_topic:=${POINT_CLOUD_TOPIC}
  gpu: true
  env:
    ROS_DOMAIN_ID: {{ (default "0" (env "ROS_DOMAIN_ID")) | quote }}
    NAMESPACE: /perception
    LOG_LEVEL: {{ (default "info" (env "LOG_LEVEL")) | quote }}
    USE_SIM_TIME: {{ (default "false" (env "USE_SIM_TIME")) | quote }}
    PARAMS: /params.yml
    TRACE: {{ (default "false" (env "TRACE")) | quote }}
    RMW_IMPLEMENTATION: rmw_zenoh_cpp
    RUST_LOG: zenoh=warn
    ZENOH_ROUTER_CHECK_ATTEMPTS: 0
  rosParamFileData: |
{{ readFile "params.yml" | indent 4 }}
  rosParamFileMountPath: /params.yml
  dependsOn:
  - host: zenoh-router
    port: 7447
