openadservice:
  namePrefix: {{ env "DEPLOYMENT_PREFIX" | quote }}
{{- if env "NODE" }}
  nodeSelector:
    kubernetes.io/hostname: {{ env "NODE" | quote }}
{{- end }}
  name: lanelet2-object-list-prediction-no-perception
  args:
  - /bin/bash
  - -ic
  - |-
    ros2 launch lanelet2_object_list_prediction lanelet2_object_list_prediction_launch.py \
      namespace:=${NAMESPACE} \
      name:=${NAME} \
      log_level:=${LOG_LEVEL} \
      use_sim_time:=${USE_SIM_TIME} \
      params:=${PARAMS} \
      tracked_object_list_topic:=${TRACKED_OBJECT_LIST_TOPIC} \
      object_list_topic:=${OBJECT_LIST_TOPIC}
  env:
    ROS_DOMAIN_ID: {{ (default "0" (env "ROS_DOMAIN_ID")) | quote }}
    NAMESPACE: /understanding
    TRACKED_OBJECT_LIST_TOPIC: /simulation/object_list
    LOG_LEVEL: {{ (default "info" (env "LOG_LEVEL")) | quote }}
    USE_SIM_TIME: {{ (default "false" (env "USE_SIM_TIME")) | quote }}
    PARAMS: /params.yml
    RMW_IMPLEMENTATION: rmw_zenoh_cpp
    RUST_LOG: zenoh=warn
    ZENOH_ROUTER_CHECK_ATTEMPTS: 0
  rosParamFileData: |
{{ readFile "params.yml" | indent 4 }}
  rosParamFileMountPath: /params.yml
  dependsOn:
  - host: zenoh-router
    port: 7447
