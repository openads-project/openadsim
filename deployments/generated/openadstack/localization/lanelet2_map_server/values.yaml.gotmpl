openadservice:
  namePrefix: {{ env "DEPLOYMENT_PREFIX" | quote }}
{{- if env "NODE" }}
  nodeSelector:
    kubernetes.io/hostname: {{ env "NODE" | quote }}
{{- end }}
  args:
  - /bin/bash
  - -ic
  - |
    ros2 run lanelet2_map_server lanelet2_map_server --ros-args \
      -r __ns:=${NAMESPACE} \
      -r __node:=${NAME} \
      -p use_sim_time:=${USE_SIM_TIME} \
      -p map_frame_id:=${MAP_FRAME_ID} \
      -p use_automatic_map_selection:=${USE_AUTOMATIC_MAP_SELECTION} \
      -p map_directory:=${MAP_DIRECTORY} \
      -p map_filepath:=${MAP_FILEPATH} \
      ${ORIGIN_LAT:+-p origin_lat:=${ORIGIN_LAT}} \
      ${ORIGIN_LON:+-p origin_lon:=${ORIGIN_LON}} \
  env:
    ROS_DOMAIN_ID: {{ (default "0" (env "ROS_DOMAIN_ID")) | quote }}
    NAMESPACE: /localization
    NAV_SAT_FIX_TOPIC: /localization/ego_state_estimation/nav_sat_fix
    LOG_LEVEL: {{ (default "info" (env "LOG_LEVEL")) | quote }}
    USE_SIM_TIME: {{ (default "false" (env "USE_SIM_TIME")) | quote }}
    PARAMS: {{ (default "/docker-ros/ws/install/lanelet2_map_server/share/lanelet2_map_server/config/params.yml" (env "PARAMS")) | quote }}
    MAP_FRAME_ID: map
    USE_AUTOMATIC_MAP_SELECTION: false
    MAP_DIRECTORY: /data/maps/default-maps
    MAP_FILEPATH: /lanelet/lanelet.osm
    ORIGIN_LAT: {{ (env "ORIGIN_LAT") | quote }}
    ORIGIN_LON: {{ (env "ORIGIN_LON") | quote }}
    RMW_IMPLEMENTATION: rmw_zenoh_cpp
    RUST_LOG: zenoh=warn
    ZENOH_ROUTER_CHECK_ATTEMPTS: 0
  volumes:
  - mountPath: /data/maps
    hostPath: {{ (printf "%s/%s" (requiredEnv "OPENADSIM_PATH") ".runtime/lanelet2-maps-v1.0.4" | clean) | quote }}
  - mountPath: /lanelet/lanelet.osm
    hostPath: {{ (ternary (printf "%s/%s" (requiredEnv "OPENADSIM_PATH") (env "CUSTOM_LANELET") | clean) "" (ne (env "CUSTOM_LANELET") "")) | quote }}
  dependsOn:
  - host: zenoh-router
    port: 7447
