openadservice:
  namePrefix: {{ env "DEPLOYMENT_PREFIX" | quote }}
{{- if env "NODE" }}
  nodeSelector:
    kubernetes.io/hostname: {{ env "NODE" | quote }}
{{- end }}
  name: carla-control-active-bridge
  args:
  - ros2
  - run
  - topic_tools
  - transform
  - /carla/ego_vehicle/vehicle_control_manual_override
  - /control/active
  - std_msgs/Bool
  - std_msgs.msg.Bool(data=not m.data)
  - --import
  - std_msgs
  env:
    NAME: carla_control_active_bridge
    RMW_IMPLEMENTATION: rmw_zenoh_cpp
    ROS_DOMAIN_ID: {{ (default "0" (env "ROS_DOMAIN_ID")) | quote }}
    RUST_LOG: zenoh=warn
    USE_SIM_TIME: {{ (default "false" (env "USE_SIM_TIME")) | quote }}
    ZENOH_ROUTER_CHECK_ATTEMPTS: 0
    LOG_LEVEL: {{ (default "info" (env "LOG_LEVEL")) | quote }}
    CONFIG: {{ (default "/docker-ros/ws/install/monitoring/share/monitoring/config/conf.rviz" (env "CONFIG")) | quote }}
  dependsOn:
  - host: zenoh-router
    port: 7447
