openadservice:
  args:
  - /bin/bash
  - -ic
  - |-
    set -e
    python3 /scenario_checker.py validate-runtime /carla-simulation/scenarios
    SCENARIOS_DIR=/carla-simulation/scenarios
    if [ -n "${CUSTOM_OPENDRIVE}" ]; then
      SCENARIOS_DIR="$(dirname "/${CUSTOM_OPENDRIVE#/}")"
    fi
    exec ros2 launch carla_ros_scenario_runner carla_ros_scenario_runner_with_selection.launch.py \
      scenario_runner_path:=${SCENARIO_RUNNER_ROOT} \
      scenarios_dir:=${SCENARIOS_DIR}
  env:
    CARLA_HOST: {{ (default "carla-server" (index .Values.composeEnvironment "CARLA_HOST")) | quote }}
    CUSTOM_LANELET: {{ (default "" (index .Values.composeEnvironment "CUSTOM_LANELET")) | quote }}
    CUSTOM_OPENDRIVE: {{ (default "" (index .Values.composeEnvironment "CUSTOM_OPENDRIVE")) | quote }}
    MAP: {{ (default "" (index .Values.composeEnvironment "MAP")) | quote }}
    RMW_IMPLEMENTATION: rmw_zenoh_cpp
    ROS_DOMAIN_ID: {{ (default "0" (index .Values.composeEnvironment "ROS_DOMAIN_ID")) | quote }}
    RUST_LOG: zenoh=warn
    SCENARIO_MAP: {{ (default (default "" (index .Values.composeEnvironment "MAP")) (index .Values.composeEnvironment "CUSTOM_OPENDRIVE")) | quote }}
    ZENOH_ROUTER_CHECK_ATTEMPTS: 0
    CARLA_PORT: {{ (default "2000" (index .Values.composeEnvironment "CARLA_PORT")) | quote }}
  volumes:
  - mountPath: /scenario_checker.py
    data: |
{{ readFile "scenario_checker.py" | indent 6 }}
  - mountPath: /carla-simulation/scenarios
    hostPath: /work/geller/openads-project/openadsim/carla-simulation/scenarios
  x11Display: {{ env "DISPLAY_X11_DOCKER" | default (env "DISPLAY") | quote }}
  x11XauthorityFile: {{ env "XAUTHORITY_DOCKER" | default "/.Xauthority" | quote }}
