openadservice:
  namePrefix: {{ env "DEPLOYMENT_PREFIX" | quote }}
{{- if env "NODE" }}
  nodeSelector:
    kubernetes.io/hostname: {{ env "NODE" | quote }}
{{- end }}
  name: carla-scenario-runner-ros-manual-testing
  image: ghcr.io/openads-project/carla-scenario-runner/ros:v0.10.0-1.1.1
  args:
  - /bin/bash
  - -ic
  - |-
    set -e
    python3 /scenario_checker.py validate-runtime /scenarios
    SCENARIOS_DIR=/scenarios
    if [ -n "${CUSTOM_OPENDRIVE}" ]; then
      SCENARIOS_DIR="$(dirname "/${CUSTOM_OPENDRIVE#/}")"
    fi
    exec ros2 launch carla_ros_scenario_runner carla_ros_scenario_runner_with_selection.launch.py \
      scenario_runner_path:=${SCENARIO_RUNNER_PATH} \
      scenarios_dir:=${SCENARIOS_DIR}
  env:
    CUSTOM_LANELET: {{ (default "" (env "CUSTOM_LANELET")) | quote }}
    CUSTOM_OPENDRIVE: {{ (default "" (env "CUSTOM_OPENDRIVE")) | quote }}
    MAP: {{ (default "" (env "MAP")) | quote }}
    RMW_IMPLEMENTATION: rmw_zenoh_cpp
    ROS_DOMAIN_ID: {{ (default "0" (env "ROS_DOMAIN_ID")) | quote }}
    RUST_LOG: zenoh=warn
    SCENARIO_MAP: {{ (default (default "" (env "MAP")) (env "CUSTOM_OPENDRIVE")) | quote }}
    ZENOH_ROUTER_CHECK_ATTEMPTS: 0
    USE_SIM_TIME: {{ (default "true" (env "USE_SIM_TIME")) | quote }}
    CARLA_HOST: {{ (default "carla-server" (env "CARLA_HOST")) | quote }}
    CARLA_PORT: {{ (default "2000" (env "CARLA_PORT")) | quote }}
  volumes:
  - mountPath: /scenario_checker.py
    data: |
{{ readFile "scenario_checker.py" | indent 6 }}
  - mountPath: /scenarios
    hostPath: /work/geller/openads-project/openadsim-k8s/scenarios
  dependsOn:
  - host: carla-server
    port: 2000
  - host: zenoh-router
    port: 7447
  x11Display: {{ env "DISPLAY_X11_DOCKER" | default (env "DISPLAY") | quote }}
  x11XauthorityFile: {{ env "XAUTHORITY_DOCKER" | quote }}
