openadservice:
  namePrefix: {{ env "DEPLOYMENT_PREFIX" | quote }}
{{- if env "NODE" }}
  nodeSelector:
    kubernetes.io/hostname: {{ env "NODE" | quote }}
{{- end }}
  image: ghcr.io/openads-project/carla-simulator:client_v0.10.0-1.1.1
  args:
  - /bin/bash
  - -ic
  - exec python3 /set_environment.py
  env:
    CARLA_HOST: carla-server
    CARLA_PORT: 2000
  volumes:
  - mountPath: /set_environment.py
    data: |
{{ readFile "set_environment.py" | indent 6 }}
  dependsOn:
  - host: carla-server
    port: 2000
