      \              \"spawn_point\": {\"x\": 1.5602, \"y\": 1.4506, \"z\": -0.0322, \"roll\": 1.0142, \"pitch\": 19.9258, \"yaw\": 90.6135}\n                }\n            ]\n        },\n        {\n            \"id\": \"karl_rack_radars\",\n            \"type\": \"group\",\n            \"children\": [\n                {\n                    \"id\": \"radar_fl\",\n                    \"type\": \"blueprint.radar_short_range\",\n                    \"spawn_point\": {\"x\": 2.0505, \"y\": 0.86, \"z\": 0.73, \"roll\": 0.0, \"pitch\": 0.0, \"yaw\": 90.0}\n                },\n                {\n                    \"id\": \"radar_f\",\n                    \"type\": \"blueprint.radar_mid_range\",\n                    \"spawn_point\": {\"x\": 2.3105, \"y\": -0.3, \"z\": 0.25, \"roll\": 0.0, \"pitch\": 0.0, \"yaw\": 0.0}\n                },\n                {\n                    \"id\": \"radar_fr\",\n                    \"type\": \"blueprint.radar_short_range\",\n                    \"spawn_point\"\
      : {\"x\": 2.0505, \"y\": -0.86, \"z\": 0.73, \"roll\": 0.0, \"pitch\": 0.0, \"yaw\": -90.0}\n                }\n            ]\n        }\n    ]\n}\n"
