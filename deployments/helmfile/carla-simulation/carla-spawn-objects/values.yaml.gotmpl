      : {\"x\": 0.3, \"y\": 0.0, \"z\": -0.7, \"roll\": 0.0, \"pitch\": 25.0, \"yaw\": -35.0}\n                },\n                {\n                    \"type\": \"blueprint.lidar_ouster_os1_128\",\n                    \"id\": \"lidar_top\",\n                    \"spawn_point\": {\"x\": 0.41, \"y\": 0.04, \"z\": 0.17, \"roll\": 0.0, \"pitch\": 27.54, \"yaw\": 0.0},\n                    \"range\": 120.0\n                },\n                {\n                    \"type\": \"blueprint.lidar_ouster_os1_128\",\n                    \"id\": \"lidar_bottom\",\n                    \"spawn_point\": {\"x\": 0.14, \"y\": 0.01, \"z\": -0.14, \"roll\": 0.0, \"pitch\": 41.36, \"yaw\": 0.0},\n                    \"range\": 120.0\n                }\n            ]\n        },\n        {\n            \"id\": \"mrisu\",\n            \"type\": \"group\",\n            \"physical_object\": \"static.prop.mrisu\",\n            \"children\":\n            [\n                {\n                    \"id\": \"sensor_platform\"\
