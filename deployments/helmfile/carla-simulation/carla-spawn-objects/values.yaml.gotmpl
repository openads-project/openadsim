  - mountPath: /config/objects/karl-all.json
    data: "{\n    \"objects\": [\n        {\n            \"type\": \"vehicle.ika.karl\",\n            \"id\": \"ego_vehicle\",\n            \"sensors\": [\n                {\n                    \"type\": \"blueprint.karl_rack_lidars\",\n                    \"id\": \"karl_rack_lidars\",\n                    \"spawn_point\": {\"x\": -2.1255, \"y\": -0.695, \"z\": 1.91, \"roll\": 0.0, \"pitch\": 0.0, \"yaw\": 0.0}\n                },\n                {\n                    \"type\": \"blueprint.karl_rack_cameras\",\n                    \"id\": \"karl_rack_cameras\",\n                    \"spawn_point\": {\"x\": -2.1255, \"y\": -0.695, \"z\": 1.91, \"roll\": 0.0, \"pitch\": 0.0, \"yaw\": 0.0}\n                },\n                {\n                    \"type\": \"blueprint.karl_rack_radars\",\n                    \"id\": \"karl_rack_radars\",\n                    \"spawn_point\": {\"x\": 0.0, \"y\": 0.0, \"z\": 0.0, \"roll\": 0.0, \"pitch\": 0.0, \"yaw\": 0.0}\n                },\n        \
