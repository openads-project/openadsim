openadservice:
  args:
  - /bin/bash
  - -ic
  - |-
    ros2 launch carla_spawn_objects carla_example_ego_vehicle.launch.py \
      blueprints_directory:=${BLUEPRINTS_DIRECTORY} \
      objects_directory:=${OBJECTS_DIRECTORY} \
      ${SPAWN_POINT:+spawn_point_ego_vehicle:=${SPAWN_POINT}} \
      ${SENSORS:+objects_definition_file:=${SENSORS}}
  env:
    BLUEPRINTS_DIRECTORY: /config/blueprints
    OBJECTS_DIRECTORY: /config/objects
    RMW_IMPLEMENTATION: rmw_zenoh_cpp
    ROS_DOMAIN_ID: {{ (default "0" (index .Values.composeEnvironment "ROS_DOMAIN_ID")) | quote }}
    RUST_LOG: zenoh=warn
    SENSORS: {{ (default "" (default "global-sensors.json,karl-minimal.json" (env "SENSORS"))) | quote }}
    SPAWN_POINT: {{ (default "" (default "50.787510,6.045938,260.0,90.0,wgs84" (env "SPAWN_POINT"))) | quote }}
    USE_SIM_TIME: {{ (default "false" (index .Values.composeEnvironment "USE_SIM_TIME")) | quote }}
    ZENOH_ROUTER_CHECK_ATTEMPTS: 0
    LOG_LEVEL: {{ (default "info" (index .Values.composeEnvironment "LOG_LEVEL")) | quote }}
    OBJECTS_DEFINITION_FILE: {{ (default "objects.json" (env "OBJECTS_DEFINITION_FILE")) | quote }}
    ROLE_NAME: {{ (default "ego_vehicle" (index .Values.composeEnvironment "ROLE_NAME")) | quote }}
    SPAWN_POINT_EGO_VEHICLE: {{ (default "None" (env "SPAWN_POINT_EGO_VEHICLE")) | quote }}
    SPAWN_SENSORS_ONLY: {{ (default "False" (env "SPAWN_SENSORS_ONLY")) | quote }}
    CONTROL_ID: {{ (default "control" (env "CONTROL_ID")) | quote }}
  volumes:
  - mountPath: /config/blueprints/cameras.json
    data: "{\n    \"blueprints\": [\n        {\n            \"id\": \"camera_rgb_1280x720_fov110_f2\",\n            \"type\": \"sensor.camera.rgb\",\n            \"image_size_x\": 1280,\n            \"image_size_y\": 720,\n            \"fov\": 110.0,\n            \"post_process_profile\": \"Town10HD_Opt\"\n        },\n        {\n            \"id\": \"camera_rgb_1280x720_fov110_f4\",\n            \"type\": \"sensor.camera.rgb\",\n            \"image_size_x\": 1280,\n            \"image_size_y\": 720,\n            \"fov\": 110.0,\n            \"post_process_profile\": \"Town10HD_Opt\"\n        },\n        {\n            \"id\": \"camera_rgb_2048x768_fov150\",\n            \"type\": \"sensor.camera.rgb\",\n            \"image_size_x\": 2048,\n            \"image_size_y\": 768,\n            \"fov\": 150.0,\n            \"post_process_profile\": \"Town10HD_Opt\"\n        },\n        {\n            \"id\": \"camera_rgb_1920x1080_fov90\",\n            \"type\": \"sensor.camera.rgb\",\n        \
      \    \"image_size_x\": 1920,\n            \"image_size_y\": 1080,\n            \"fov\": 90.0,\n            \"post_process_profile\": \"Town10HD_Opt\"\n        },\n        {\n            \"id\": \"camera_rgb_400x300_fov90\",\n            \"type\": \"sensor.camera.rgb\",\n            \"image_size_x\": 400,\n            \"image_size_y\": 300,\n            \"fov\": 90.0,\n            \"post_process_profile\": \"Town10HD_Opt\"\n        },\n        {\n            \"id\": \"camera_depth_1280x720\",\n            \"type\": \"sensor.camera.depth\",\n            \"image_size_x\": 1280,\n            \"image_size_y\": 720,\n            \"fov\": 90.0,\n            \"post_process_profile\": \"Town10HD_Opt\"\n        },\n        {\n            \"id\": \"camera_semantic_1280x720\",\n            \"type\": \"sensor.camera.semantic_segmentation\",\n            \"image_size_x\": 1280,\n            \"image_size_y\": 720,\n            \"fov\": 90.0,\n            \"post_process_profile\": \"Town10HD_Opt\"\
      \n        },\n        {\n            \"id\": \"camera_rgb_view\",\n            \"type\": \"sensor.camera.rgb\",\n            \"spawn_point\": {\"x\": -5.0, \"y\": 0.0, \"z\": 3.5, \"roll\": 0.0, \"pitch\": 20.0, \"yaw\": 0.0},\n            \"image_size_x\": 1280,\n            \"image_size_y\": 720,\n            \"post_process_profile\": \"Town10HD_Opt\"\n        },\n        {\n            \"id\": \"camera_traffic_light_2048x768_fov150\",\n            \"type\": \"sensor.camera.rgb\",\n            \"image_size_x\": 2048,\n            \"image_size_y\": 768,\n            \"fov\": 150.0,\n            \"post_process_profile\": \"Town10HD_Opt\"\n        },\n        {\n            \"id\": \"camera_traffic_light_1280x720_fov110\",\n            \"type\": \"sensor.camera.rgb\",\n            \"image_size_x\": 1280,\n            \"image_size_y\": 720,\n            \"fov\": 110.0,\n            \"post_process_profile\": \"Town10HD_Opt\"\n        }\n    ]\n}\n"
  - mountPath: /config/blueprints/karl.json
    data: "{\n    \"blueprints\": [\n        {\n            \"id\": \"karl_rack_lidars\",\n            \"type\": \"group\",\n            \"children\": [\n                {\n                    \"id\": \"lidar_front\",\n                    \"type\": \"blueprint.lidar_aeries_ii\",\n                    \"spawn_point\": {\"x\": 2.8499, \"y\": 0.6455, \"z\": 0.0614, \"roll\": 0.0, \"pitch\": 0.0, \"yaw\": -3.4377}\n                },\n                {\n                    \"id\": \"lidar_fl\",\n                    \"type\": \"blueprint.lidar_ouster_os1_128\",\n                    \"spawn_point\": {\"x\": 2.89, \"y\": 1.444, \"z\": 0.1, \"roll\": 0.0, \"pitch\": 20.0, \"yaw\": 45.0}\n                },\n                {\n                    \"id\": \"lidar_fr\",\n                    \"type\": \"blueprint.lidar_ouster_os1_128\",\n                    \"spawn_point\": {\"x\": 2.89, \"y\": 0.04, \"z\": 0.1, \"roll\": 0.0, \"pitch\": 20.0, \"yaw\": -45.0}\n                },\n                {\n\
      \                    \"id\": \"lidar_rr\",\n                    \"type\": \"blueprint.lidar_ouster_os1_128\",\n                    \"spawn_point\": {\"x\": 0.04, \"y\": 0.04, \"z\": 0.1, \"roll\": 0.0, \"pitch\": 20.0, \"yaw\": -135.0}\n                },\n                {\n                    \"id\": \"lidar_rl\",\n                    \"type\": \"blueprint.lidar_ouster_os1_128\",\n                    \"spawn_point\": {\"x\": 0.04, \"y\": 1.444, \"z\": 0.1, \"roll\": 0.0, \"pitch\": 20.0, \"yaw\": 135.0}\n                }\n            ]\n        },\n        {\n            \"id\": \"karl_rack_cameras\",\n            \"type\": \"group\",\n            \"children\": [\n                {\n                    \"id\": \"camera_front_left\",\n                    \"type\": \"blueprint.camera_rgb_1280x720_fov110_f4\",\n                    \"spawn_point\": {\"x\": 2.8146, \"y\": 1.4637, \"z\": -0.0013, \"roll\": -0.1166, \"pitch\": 5.9344, \"yaw\": 45.1565}\n                },\n           \
      \     {\n                    \"id\": \"camera_front_center\",\n                    \"type\": \"blueprint.camera_rgb_1280x720_fov110_f4\",\n                    \"spawn_point\": {\"x\": 2.9592, \"y\": 0.7903, \"z\": 0.0061, \"roll\": 0.1078, \"pitch\": 5.5148, \"yaw\": 0.3433}\n                },\n                {\n                    \"id\": \"camera_front_right\",\n                    \"type\": \"blueprint.camera_rgb_1280x720_fov110_f4\",\n                    \"spawn_point\": {\"x\": 2.9388, \"y\": 0.0951, \"z\": 0.0067, \"roll\": 0.1934, \"pitch\": 5.3588, \"yaw\": -43.6624}\n                },\n                {\n                    \"id\": \"camera_mid_right\",\n                    \"type\": \"blueprint.camera_rgb_1280x720_fov110_f2\",\n                    \"spawn_point\": {\"x\": 1.685, \"y\": 0.0027, \"z\": 0.0021, \"roll\": 0.3284, \"pitch\": 20.9842, \"yaw\": -89.2525}\n                },\n                {\n                    \"id\": \"camera_rear_right\",\n             \
