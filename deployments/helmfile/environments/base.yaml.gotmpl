# generated from host-side variables referenced by multiple generated services.
# export variables before running Helmfile; generation-time values are not retained.
composeEnvironment:
  CARLA_HOST: {{ env "CARLA_HOST" | quote }}
  CARLA_PORT: {{ env "CARLA_PORT" | quote }}
  CUSTOM_LANELET: {{ env "CUSTOM_LANELET" | quote }}
  CUSTOM_OPENDRIVE: {{ env "CUSTOM_OPENDRIVE" | quote }}
  LOG_LEVEL: {{ env "LOG_LEVEL" | quote }}
  MAP: {{ env "MAP" | quote }}
  ROS_DOMAIN_ID: {{ env "ROS_DOMAIN_ID" | quote }}
  TRACE: {{ env "TRACE" | quote }}
  USE_SIM_TIME: {{ env "USE_SIM_TIME" | quote }}
