openadservice:
  env:
    NAMESPACE: /control
    EGO_DATA_TOPIC: /localization/ego_state_estimation/ego_data
    LAT_CONTROL_ACTIVE_TOPIC: /control/active
    LON_CONTROL_ACTIVE_TOPIC: /control/active
    PARAMS: /params.yml
    RMW_IMPLEMENTATION: rmw_zenoh_cpp
    ROS_DOMAIN_ID: {{ (default "0" (env "ROS_DOMAIN_ID")) | quote }}
    RUST_LOG: zenoh=warn
    TRAJECTORY_TOPIC: /planning/trajectory_optimization/trajectory
    USE_SIM_TIME: {{ (default "false" (env "USE_SIM_TIME")) | quote }}
    ZENOH_ROUTER_CHECK_ATTEMPTS: 0
    LOG_LEVEL: {{ (default "info" (env "LOG_LEVEL")) | quote }}
    TRACE: {{ (default "False" (env "TRACE")) | quote }}
  volumes:
  - mountPath: /docker-ros/ws/install/ackermann_trajectory_control/share/ackermann_trajectory_control/config/karl-lateral-limits-v1p3.csv
    data: |
{{ readFile "karl-lateral-limits-v1p3.csv" | indent 6 }}
  rosParamFileData: |
{{ readFile "params.yml" | indent 4 }}
  rosParamFileMountPath: /params.yml
  dependsOn:
  - host: zenoh-router
    port: 7447
