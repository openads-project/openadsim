openadservice:
  namePrefix: {{ env "DEPLOYMENT_PREFIX" | quote }}
{{- if env "NODE" }}
  nodeSelector:
    kubernetes.io/hostname: {{ env "NODE" | quote }}
{{- end }}
  name: rviz-carla
  args:
  - bash
  - -ic
  - rviz2 -d /conf.rviz --ros-args -p use_sim_time:=true
  gpu: true
  env:
    NAMESPACE: /monitoring
    CONFIG: /conf.rviz
    RMW_IMPLEMENTATION: rmw_zenoh_cpp
    ROS_DOMAIN_ID: {{ (default "0" (env "ROS_DOMAIN_ID")) | quote }}
    RUST_LOG: zenoh=warn
    USE_SIM_TIME: {{ (default "false" (env "USE_SIM_TIME")) | quote }}
    ZENOH_ROUTER_CHECK_ATTEMPTS: 0
    LOG_LEVEL: {{ (default "info" (env "LOG_LEVEL")) | quote }}
  volumes:
  - mountPath: /docker-ros/ws/monitoring-volume
    hostPath: {{ (printf "%s/%s" (requiredEnv "OPENADSIM_PATH") "openadstack/monitoring/volume" | clean) | quote }}
  - mountPath: /mesh
    image: ghcr.io/openads-project/openads-assets:v1.0.0
    imagePath: mesh
  - mountPath: /conf.rviz
    data: |
{{ readFile "carla.rviz" | indent 6 }}
  dependsOn:
  - host: zenoh-router
    port: 7447
  x11Display: {{ env "DISPLAY_X11_DOCKER" | default (env "DISPLAY") | quote }}
  x11XauthorityFile: {{ env "XAUTHORITY_DOCKER" | quote }}
