openadservice:
  image: ghcr.io/openads-project/point_cloud_object_detection:v3.0.0-slim
  args:
  - /bin/bash
  - -ic
  - |-
    ros2 launch point_cloud_object_detection point_cloud_object_detection.launch.py \
      namespace:=${NAMESPACE} \
      name:=${NAME} \
      log_level:=${LOG_LEVEL} \
      use_sim_time:=${USE_SIM_TIME} \
      params:=${PARAMS} \
      trace:=${TRACE} \
      point_cloud_topic:=${POINT_CLOUD_TOPIC} \
      object_list_topic:=${OBJECT_LIST_TOPIC} \
      no_detection_zone_topic:=${NO_DETECTION_ZONE_TOPIC} \
      no_detection_zone_points_topic:=${NO_DETECTION_ZONE_POINTS_TOPIC} \
      detection_area_topic:=${DETECTION_AREA_TOPIC} \
      model_bounds_topic:=${MODEL_BOUNDS_TOPIC} \
      density_grid_map_topic:=${DENSITY_GRID_MAP_TOPIC} \
      dynamic_grid_map_topic:=${DYNAMIC_GRID_MAP_TOPIC} \
      combined_grid_map_topic:=${COMBINED_GRID_MAP_TOPIC} \
      static_grid_map_topic:=${STATIC_GRID_MAP_TOPIC}
  gpu: true
  env:
    NAMESPACE: /perception
    PARAMS: /params.yml
    POINT_CLOUD_TOPIC: /perception/point_cloud_fusion/point_cloud
    RMW_IMPLEMENTATION: rmw_zenoh_cpp
    ROS_DOMAIN_ID: {{ (default "0" (index .Values.composeEnvironment "ROS_DOMAIN_ID")) | quote }}
    RUST_LOG: zenoh=warn
    TRACE: {{ (default "false" (index .Values.composeEnvironment "TRACE")) | quote }}
    USE_SIM_TIME: {{ (default "false" (index .Values.composeEnvironment "USE_SIM_TIME")) | quote }}
    ZENOH_ROUTER_CHECK_ATTEMPTS: 0
    LOG_LEVEL: {{ (default "info" (index .Values.composeEnvironment "LOG_LEVEL")) | quote }}
  volumes:
  - mountPath: /models
    image: ghcr.io/openads-project/point_cloud_object_detection/model:v1.0.0
    imagePath: models
  rosParamFileData: |
{{ readFile "params.yml" | indent 4 }}
  rosParamFileMountPath: /params.yml
