<?xml version="1.0" encoding="UTF-8"?>
<!--
    Town03 with traffic only in the north-east corner around the tunnel,
    selected with COSIM_SCENARIO=town03-tunnel. The objects.json next to this
    file spawns the three mRISUs in CARLA.

    net/town03_tunnel.net.xml is the standard Town03 net of the coordinator image with
    25 km/h on the car lanes within 75 m of the mRISUs, so traffic stays longer in their view.
    rou/town03_tunnel.rou.xml inserts, drives and removes every vehicle inside the
    corner around the mRISUs. Both are generated by tools/generate_sumo.sh.
-->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="net/town03_tunnel.net.xml"/>
        <route-files value="rou/town03_tunnel.rou.xml,/sumo-config/carlavtypes.rou.xml"/>
    </input>

</configuration>
