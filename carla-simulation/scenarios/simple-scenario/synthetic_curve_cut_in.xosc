                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="act_start" delay="0.0" conditionEdge="none">
                            <ByValueCondition>
                                <SimulationTimeCondition value="0.0" rule="greaterThan"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger>
                    <ConditionGroup>
                        <Condition name="StoptriggerTime" delay="0.0" conditionEdge="rising">
                            <ByValueCondition>
                                <SimulationTimeCondition value="60.0" rule="greaterThan"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                    <ConditionGroup>
                        <Condition conditionEdge="rising" delay="0" name="EgoRouteDone">
                            <ByValueCondition>
                                <StoryboardElementStateCondition
                                    storyboardElementType="event"
                                    storyboardElementRef="Route_ego_vehicle"
                                    state="completeState" />
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StopTrigger>
            </Act>
        </Story>
        <StopTrigger>
            <ConditionGroup>
                <Condition name="criteria_RunningStopTest" delay="0.0" conditionEdge="rising">
                    <ByValueCondition>
                        <ParameterCondition parameterRef="" value="0" rule="lessThan"/>
                    </ByValueCondition>
                </Condition>
                <Condition name="criteria_RunningRedLightTest" delay="0.0" conditionEdge="rising">
                    <ByValueCondition>
                        <ParameterCondition parameterRef="" value="0" rule="lessThan"/>
                    </ByValueCondition>
                </Condition>
                <Condition name="criteria_CollisionTest" delay="0.0" conditionEdge="rising">
                    <ByValueCondition>
                        <ParameterCondition parameterRef="" value="0" rule="lessThan"/>
                    </ByValueCondition>
                </Condition>
                <Condition name="criteria_WrongLaneTest" delay="0.0" conditionEdge="rising">
                    <ByValueCondition>
                        <ParameterCondition parameterRef="" value="0" rule="lessThan"/>
                    </ByValueCondition>
                </Condition>
                <Condition name="criteria_OnSidewalkTest" delay="0.0" conditionEdge="rising">
                    <ByValueCondition>
                        <ParameterCondition parameterRef="" value="0" rule="lessThan"/>
                    </ByValueCondition>
                </Condition>
                <Condition name="criteria_DrivenDistanceTest" delay="0.0" conditionEdge="rising">
                    <ByValueCondition>
                        <ParameterCondition parameterRef="distance_success" value="170" rule="lessThan"/>
                    </ByValueCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>
