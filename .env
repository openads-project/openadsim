### Runtime Profiles
COMPOSE_PROFILES=carla,traffic,manual-testing,no-perception,planning
# CARLA-SUMO co-simulation:
# COMPOSE_PROFILES=carla-sumo,no-traffic,no-testing,no-perception,planning
# COMPOSE_FILE=docker-compose.yml:carla-sumo-simulation/docker-compose.override.yml

### Vehicle Configuration
VEHICLE=karl
SENSORS=global-sensors.json,karl-minimal.json

### Map Configuration
MAP=campus
CUSTOM_OPENDRIVE=
CUSTOM_LANELET=
SPAWN_POINT=50.787510,6.045938,260.0,90.0,wgs84
ORIGIN_LAT=
ORIGIN_LON=
LANELET_RELOAD=true

### Scenario Configuration
SCENARIO_FILE=

### Co-Simulation Configuration
COSIM_SCENARIO=
SUMO_CFG=
CARLA_START_TIME=

### Additional Options
USE_SIM_TIME=true
ROS_TRACING=false
